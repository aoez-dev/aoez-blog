---
/** Deterministic cover art for posts without a `cover` image. Colours come from the theme. */
import { shortHash } from "@/utils/shortHash";

export interface Props {
  seed: string;
}

const { seed } = Astro.props;
const hash = shortHash(seed);
const motif = parseInt(hash, 16) % 6;
const uid = `gp-${hash}`;

const mono = `font-family="JetBrains Mono Variable, monospace"`;
const arts = [
  `<circle cx="160" cy="88" r="42" fill="none" stroke="var(--cmt)" stroke-width="1.5" stroke-dasharray="3 5"/><path d="M160 46l9 5-9 5" fill="none" stroke="var(--cmt)" stroke-width="1.5"/><circle cx="202" cy="88" r="5" fill="var(--accent)"/><circle cx="118" cy="88" r="3" fill="var(--cmt)"/><circle cx="160" cy="130" r="3" fill="var(--dim)"/><text x="160" y="92" text-anchor="middle" font-size="12" fill="var(--dim)" ${mono}>retry ×2</text>`,
  `<rect x="76" y="40" width="168" height="100" rx="8" fill="var(--bg)" stroke="var(--line)"/><path d="M76 58h168" stroke="var(--line)"/><circle cx="88" cy="49" r="2.5" fill="var(--cmt)"/><circle cx="98" cy="49" r="2.5" fill="var(--cmt)"/><circle cx="108" cy="49" r="2.5" fill="var(--cmt)"/><text x="92" y="82" font-size="11" fill="var(--accent)" ${mono}>&gt;</text><rect x="106" y="74" width="84" height="5" rx="2" fill="var(--dim)" opacity=".7"/><rect x="92" y="96" width="120" height="4" rx="2" fill="var(--line)"/><rect x="92" y="108" width="96" height="4" rx="2" fill="var(--line)"/><rect x="92" y="120" width="8" height="12" fill="var(--accent)"/>`,
  `<path d="M70 140h180" stroke="var(--line)"/>${[34, 52, 40, 66, 50, 80].map((h, k) => `<rect x="${82 + k * 26}" y="${140 - h}" width="14" height="${h}" rx="2" fill="${k === 5 ? "var(--accent)" : "var(--cmt)"}" opacity="${k === 5 ? 1 : 0.55}"/>`).join("")}`,
  `<text x="160" y="104" text-anchor="middle" font-size="64" fill="var(--cmt)" ${mono}>{ }</text>${[0, 1, 2, 3, 4].map(k => `<rect x="${96 + k * 32}" y="132" width="${14 + (k % 3) * 6}" height="4" rx="2" fill="${k === 4 ? "var(--accent)" : "var(--line)"}"/>`).join("")}`,
  `<rect x="100" y="104" width="120" height="26" rx="4" fill="var(--line)"/><rect x="110" y="82" width="100" height="26" rx="4" fill="var(--cmt)" opacity=".6"/><rect x="120" y="60" width="80" height="26" rx="4" fill="var(--accent)"/><text x="160" y="78" text-anchor="middle" font-size="12" fill="var(--ink)" font-weight="700" ${mono}>100</text>`,
  `<rect x="64" y="78" width="192" height="24" rx="4" fill="none" stroke="var(--line)"/><rect x="64" y="78" width="120" height="24" rx="4" fill="var(--accent)" opacity=".8"/><rect x="184" y="78" width="30" height="24" fill="var(--cmt)" opacity=".5"/><text x="64" y="124" font-size="11" fill="var(--dim)" ${mono}>budget 272k</text><text x="256" y="124" text-anchor="end" font-size="11" fill="var(--cmt)" ${mono}>spent 0.4%</text>`,
];
---

<svg
  viewBox="0 0 320 180"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  set:html={`<defs><pattern id="${uid}" width="20" height="20" patternUnits="userSpaceOnUse"><path d="M20 0H0V20" fill="none" stroke="var(--line)" stroke-width=".5" opacity=".6"/></pattern></defs><rect width="320" height="180" fill="url(#${uid})"/>${arts[motif]}`}
/>
