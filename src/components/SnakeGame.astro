---
export interface Props {
  seed: string;
}
const { seed } = Astro.props;
const json = JSON.stringify({ seed }).replace(/</g, "\\u003c");
---

<section class="snake" id="snake" aria-labelledby="snake-title">
  <header class="snake-head">
    <h2 id="snake-title">Bored? Here, play some <span class="snake-fancy">Snake</span>.</h2>
    <p>Arrow keys or WASD, swipe on a phone. It gets faster with every point.</p>
  </header>
  <div class="snake-body">
    <div
      class="snake-board"
      data-board
      tabindex="0"
      role="application"
      aria-label="Snake board. Use the arrow keys to steer the snake."
    >
      <canvas aria-hidden="true"></canvas>
    </div>
    <div class="snake-side">
      <dl class="snake-stats" aria-live="polite">
        <div><dt>Score</dt><dd data-score>0</dd></div>
        <div><dt>Best</dt><dd data-best>0</dd></div>
        <div><dt>Speed</dt><dd data-speed>1.0x</dd></div>
      </dl>
      <button type="button" class="btn p snake-start" data-start>Start game</button>
    </div>
  </div>
  <p class="snake-msg" data-msg aria-live="polite"></p>
  <noscript><p class="empty-note">The game needs JavaScript.</p></noscript>
</section>

<script id="snake-data" type="application/json" set:html={json} />

<script>
  import { initSnake } from "@/lib/snake/snake";

  let dispose: (() => void) | null = null;

  document.addEventListener("astro:page-load", () => {
    dispose?.();
    dispose = null;
    const root = document.getElementById("snake");
    const raw = document.getElementById("snake-data")?.textContent;
    if (root && raw) dispose = initSnake(root, JSON.parse(raw));
  });
  document.addEventListener("astro:before-swap", () => {
    dispose?.();
    dispose = null;
  });
</script>
