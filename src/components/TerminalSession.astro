---
import { HERO } from "@/config";
import type { TerminalData } from "@/lib/terminal/types";

export interface Props {
  data: TerminalData;
}

const { data } = Astro.props;
// "</" must not end the JSON <script> early
const json = JSON.stringify(data).replace(/</g, "\\u003c");
---

<div class="win" id="terminal">
  <div class="wbar">
    <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="ttl">aoez@dev: ~ — zsh</span>
  </div>

  <div class="sess" id="sess" tabindex="0" aria-label="Terminal history">
    <h1 class="sr-only">{HERO.name}, {HERO.tagline}</h1>
    <nav class="sr-only" aria-label="All posts" data-pagefind-ignore>
      <ul>
        {
          data.posts.map(p => (
            <li>
              <a href={p.url}>{p.title}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <pre class="ascii" id="ascii" aria-hidden="true"></pre>
    <noscript>
      <p class="intro">
        This terminal needs JavaScript. Read the <a href="/posts">posts</a> or
        the <a href="/about">about</a> page instead.
      </p>
    </noscript>
    <div class="who">
      {HERO.name} · <span>{HERO.tagline}</span>
    </div>
    <div class="hints">
      <b>tab</b> complete · <b>/</b> commands · <b>!</b> shell · <b>esc</b> clear · <b>esc esc</b> leave
    </div>
    <p class="intro">{HERO.bio} Press Tab to see what you can run.</p>
    <div class="ctx"><em>[Loaded]</em> <b>{data.posts.length}</b> posts</div>
    <div id="hist" role="log" aria-label="Command output"></div>
  </div>

  <div class="bottom">
    <div class="box" id="box" hidden>
      <span class="pr">›</span>
      <div class="field empty" id="field">
        <input
          id="inp"
          type="text"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          aria-label="Command prompt"
        />
        <span class="ovl" aria-hidden="true"
          ><i class="cur"></i><span class="ph" id="ph"></span></span
        >
      </div>
      <button type="button" class="kb" id="tabBtn" aria-label="Cycle commands"
        >⇥</button
      >
      <button type="button" class="kb" id="goBtn" aria-label="Run">↵</button>
    </div>
    <div class="pick" id="pick" tabindex="-1" hidden></div>
    <div class="sr-only" id="live" role="status" aria-live="polite"></div>
    <div class="stat" id="sl" aria-hidden="true"></div>
  </div>
</div>

<script id="terminal-data" type="application/json" set:html={json} />

<script>
  import { initTerminal } from "@/lib/terminal/terminal";

  let dispose: (() => void) | null = null;

  document.addEventListener("astro:page-load", () => {
    dispose?.();
    dispose = null;
    const root = document.getElementById("terminal");
    if (root) dispose = initTerminal(root);
  });
  document.addEventListener("astro:before-swap", () => {
    dispose?.();
    dispose = null;
  });
</script>
