---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import TerminalSession from "@/components/TerminalSession.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { buildTerminalData } from "@/lib/terminal/data";

const posts = getSortedPosts(await getCollection("blog"));
const data = buildTerminalData(posts);
---

<Layout crumb={[{ label: "~/aoez.dev" }]}>
  <main id="main-content" class="frame terminal-page">
    <TerminalSession {data} />
  </main>
</Layout>
