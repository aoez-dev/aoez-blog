---
import Layout from "@/layouts/Layout.astro";
import SnakeGame from "@/components/SnakeGame.astro";
import { SITE } from "@/config";
---

<Layout
  title={`404 Not Found | ${SITE.title}`}
  crumb={[{ label: "~/aoez.dev", href: "/" }, { label: "404" }]}
>
  <main id="main-content" class="frame page">
    <div class="pin">
      <div class="cmd"><b>$</b> cd <u>{Astro.url.pathname}</u></div>
      <h1 class="pt">404</h1>
      <p class="empty-note">zsh: no such file or directory. Nothing lives here.</p>
      <p style="margin-top:18px"><a class="btn p" href="/">cd ~</a></p>
      <SnakeGame seed={Astro.url.pathname} />
    </div>
  </main>
</Layout>
